(version 1)
(allow default)
(deny file-read* (subpath "/Users") (subpath "/Volumes") (subpath "/private/tmp") (subpath "/private/var/folders"))
(allow file-read* (subpath "/private/tmp/oncosys-runtime-k2vhjg41"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/oncosys-runtime-k2vhjg41") (literal "/dev/null"))
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
(deny network-outbound (remote ip "localhost:11434"))
(allow file-read-metadata)
